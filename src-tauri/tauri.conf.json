{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nolithium",
  "version": "0.1.0",
  "identifier": "com.nolithium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Nolithium",
      "width": 1000,
      "height": 820,
      "minWidth": 540,
      "minHeight": 440,
      "transparent": true,
      "decorations": false,
      "backgroundColor": "#00000000",
      "theme": "Dark",
      "visible": false,
      "windowEffects": { "effects": ["acrylic"], "color": "#090B0E30" }
    }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": true, "targets": ["nsis"], "icon": ["icons/icon.ico"] }
}
