{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nolithium",
  "version": "0.3.1",
  "identifier": "com.nolithium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nolithium",
        "width": 1000,
        "height": 820,
        "minWidth": 540,
        "minHeight": 440,
        "transparent": true,
        "decorations": false,
        "backgroundColor": "#00000000",
        "theme": "Dark",
        "visible": false,
        "windowEffects": {
          "effects": [
            "acrylic"
          ],
          "color": "#090B0E30"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "English",
          "Turkish"
        ],
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "publisher": "Murat Emre Biçici",
    "copyright": "© 2026 Murat Emre Biçici",
    "license": "MIT"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQzhCQTVEMzY2QjFGQzEKUldUQkgyczJYYnJJUEJpQUhOdnBuMFE4NHJMb1FxWTE2OEFoeGhlbzN6OGFKUnNXckx1TFVsZWwK",
      "endpoints": [
        "https://github.com/MuratBicici/Nolithium/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
